{
  "name": "bardos-breakfast-burgers",
  "private": true,
  "version": "4.1.0",
  "type": "module",
  "description": "Bardo's Breakfast Burgers webapp concept for a local breakfast and burger restaurant in Salem, Oregon.",
  "scripts": {
    "dev": "vite",
    "dev:systemx": "node .SYSTEMX/LAN/runner.mjs vite",
    "build": "tsc -b --noCheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "emulators": "node .SYSTEMX/LAN/runner.mjs firebase",
    "emulators:export": "node .SYSTEMX/LAN/runner.mjs firebase --export-on-exit=.emulator-data --import=.emulator-data",
    "test": "node .SYSTEMX/scripts/run-tests.mjs",
    "deploy": "node .SYSTEMX/cli/systemx.mjs deploy",
    "system:audit": "node .SYSTEMX/cli/systemx.mjs audit",
    "sync:system": "node .SYSTEMX/cli/systemx.mjs sync",
    "sync:system:check": "node .SYSTEMX/cli/systemx.mjs sync --check",
    "wtl:menu": "node .SYSTEMX/cli/systemx.mjs menu",
    "wtl:setup": "node .SYSTEMX/cli/systemx.mjs setup",
    "wtl:doctor": "node .SYSTEMX/cli/systemx.mjs doctor",
    "wtl:diagnostics": "node .SYSTEMX/cli/systemx.mjs diagnostics",
    "wtl:quality": "node .SYSTEMX/cli/systemx.mjs quality",
    "wtl:deploy": "node .SYSTEMX/cli/systemx.mjs deploy",
    "wtl:packet": "node .SYSTEMX/cli/systemx.mjs packet",
    "wtl:kit": "node .SYSTEMX/cli/systemx.mjs kit",
    "wtl:sync": "node .SYSTEMX/cli/systemx.mjs sync",
    "wtl:audit": "node .SYSTEMX/cli/systemx.mjs audit",
    "wtl:bus": "node .SYSTEMX/cli/systemx.mjs bus",
    "wtl:mcp": "node .SYSTEMX/cli/systemx.mjs mcp generate",
    "wtl:firebase": "node .SYSTEMX/cli/systemx.mjs firebase",
    "wtl:hooks": "node .SYSTEMX/cli/systemx.mjs hooks install",
    "wtl:local": "node .SYSTEMX/cli/systemx.mjs local",
    "wtl:slc": "node .SYSTEMX/cli/systemx.mjs slc",
    "wtl:platform": "node .SYSTEMX/cli/systemx.mjs platform",
    "start:day": "node .SYSTEMX/cli/systemx.mjs local start-day",
    "end:day": "node .SYSTEMX/cli/systemx.mjs local end-day",
    "setup:unified:scrape:list": "node .SYSTEMX/Unified-Setup-Process/scrape/repo-manifest-scraper.mjs --list",
    "setup:unified:scrape:dry-run": "node .SYSTEMX/Unified-Setup-Process/scrape/repo-manifest-scraper.mjs --dry-run",
    "setup:unified:scrape": "node .SYSTEMX/Unified-Setup-Process/scrape/repo-manifest-scraper.mjs --write",
    "setup:packet:export": "bash .SYSTEMX/scripts/build-setup-packet.sh",
    "setup:packet:import": "bash .SYSTEMX/scripts/import-setup-packet.sh",
    "setup:test-users": "node scripts/setup/seed-test-users.mjs",
    "setup:test-users:write": "node scripts/setup/seed-test-users.mjs --write",
    "account-levels:check": "node .SYSTEMX/scripts/account-level-check.mjs",
    "auth:mfa:check": "node .SYSTEMX/scripts/auth-mfa-readiness-check.mjs",
    "ai:standard:check": "node .SYSTEMX/scripts/agent-standard-check.mjs",
    "browser:install": "npx --no-install playwright install chromium",
    "browser:codegen": "npx --no-install playwright codegen http://localhost:5173",
    "mcp:chrome": "npx --no-install chrome-devtools-mcp --help",
    "ci:lint": "eslint . --max-warnings=0",
    "ci:typecheck": "tsc --noEmit -p tsconfig.json",
    "ci:test": "npm run test",
    "ci:build": "vite build",
    "ci:audit": "npm audit --audit-level=high",
    "ci:security": "node .SYSTEMX/scripts/security-check.mjs && node .SYSTEMX/scripts/account-level-check.mjs && node .SYSTEMX/scripts/auth-mfa-readiness-check.mjs",
    "ci:ai": "node .SYSTEMX/scripts/agent-standard-check.mjs",
    "ci:all": "npm run ci:lint && npm run ci:typecheck && npm run ci:test && npm run ci:security && npm run ci:ai && npm run system:audit && npm run ci:build"
  },
  "dependencies": {
    "firebase": "^12.14.0",
    "lucide-react": "^0.484.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.1.18",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^17.1.0",
    "playwright": "1.56.1",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.60.0",
    "vite": "^8.1.3"
  }
}
