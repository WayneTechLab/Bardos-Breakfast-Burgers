rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function accountLevel() {
      return request.auth != null && exists(/databases/$(database)/documents/roles/$(request.auth.uid))
        ? get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.level : 0;
    }
    function hasMinLevel(level) {
      return request.auth != null && accountLevel() >= level
        && !get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.disabled
        && (request.auth.token.aud == 'demo-bardos-local' || request.auth.token.firebase.sign_in_second_factor != null);
    }
    function isAdmin() { return hasMinLevel(4); }
    match /menu/{item} {
      allow read: if resource.data.active == true || isAdmin();
      allow write: if false;
    }
    match /content/{item} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if false;
    }
    // Private business data and role assignment go through authenticated Functions.
    match /adminUsers/{uid} { allow read, write: if false; }
    match /securityProfiles/{uid} { allow read, write: if false; }
    match /totpSecrets/{uid} { allow read, write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
